# PostgreSQL connection settings
# Copy this file to .env.local and fill in your actual values.

PGHOST=localhost
PGPORT=5432
PGDATABASE=stellar_archive
PGUSER=postgres
PGPASSWORD=your_password_here

# Required for signed login sessions; use a random string of at least 32 characters.
SESSION_SECRET=replace_with_a_random_32_character_secret

# db:init creates or updates the administrator account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_password_12_characters_or_longer

# Optional read-only account.
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=replace_with_a_unique_password_12_characters_or_longer
